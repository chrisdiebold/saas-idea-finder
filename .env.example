# Copy to .env to override defaults. All settings are optional.
# IDEAFINDER_DATABASE_URL=postgresql://localhost:5432/ideafinder
# IDEAFINDER_WEB_HOST=127.0.0.1
# IDEAFINDER_WEB_PORT=8765

# Running it daily
# IDEAFINDER_BACKUP_DIR=/Users/you/Library/Mobile Documents/com~apple~CloudDocs/IdeaFinder backups
# IDEAFINDER_BACKUP_KEEP_DAYS=14
# IDEAFINDER_DAILY_EXTRACT_MINUTES=90

# Phase 2 Sources (all optional)
# IDEAFINDER_GITHUB_TOKEN=github_pat_...        # 5,000 requests/hour instead of 60
# IDEAFINDER_PRODUCTHUNT_TOKEN=...              # then set enabled: true for producthunt in config/sources.yaml
# IDEAFINDER_BLUESKY_HANDLE=you.bsky.social     # with an app password, search can page back past 100 posts
# IDEAFINDER_BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
